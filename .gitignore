# =================================================================
# Vanijya (वाणिज्य) - Comprehensive Git Ignore Rules
# =================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js Build Outputs & Cache
.next/
out/

# Compiled Build Artifacts
dist/
build/
*.tsbuildinfo

# Testing & Coverage
coverage/
.nyc_output/

# Cache Directories
.cache/
.turbo/
.eslintcache/
.parcel-cache/
.vite/

# Environment Variables & Secrets (Keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Logs & Diagnostic Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System Metadata
.DS_Store
Thumbs.db
desktop.ini
*.directory

# IDE & Editor Metadata
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & Swap Files
tmp/
temp/
*.tmp
*.temp

# Process & Runtime Files
*.pid
*.seed
*.pid.lock

# User Uploads / Media storage
uploads/*
!uploads/.gitkeep
apps/backend/uploads/*
!apps/backend/uploads/.gitkeep
!apps/backend/uploads/profile-photos/
apps/backend/uploads/profile-photos/*
!apps/backend/uploads/profile-photos/.gitkeep


